## 3. Example Service Functions

Below are pseudo-code examples for how the logic might look in a service layer.

### A. **Create or Update an Entity with Actual Value**

```python
def create_or_update_entity_with_actual_value(
    db: Session,
    entity_data: dict,
    actual_value: float,
    actual_value_date: date,
    entity_type: str
):
    # 1. Create the entity record
    if entity_type == "asset":
        new_entity = Asset(**entity_data)
        db.add(new_entity)
        db.commit()
        db.refresh(new_entity)
        entity_id = new_entity.id
    else:
        # handle other entity types similarly
        pass

    # 2. Get Actual scenario
    actual_scenario = db.query(Scenario).filter(Scenario.is_default == True).first()

    # 3. Create or update ValueRecord
    #    For creation time, we assume there's no existing record
    new_value = ValueRecord(
        entity_type=entity_type,
        entity_id=entity_id,
        scenario_id=actual_scenario.id,
        value_date=actual_value_date,
        value_amount=actual_value
    )
    db.add(new_value)
    db.commit()
    db.refresh(new_value)

    return new_entity
```

### B. **Edit Actual Value for an Existing Entity**

```python
def edit_actual_value_for_entity(
    db: Session,
    entity_type: str,
    entity_id: int,
    new_value_amount: float,
    new_value_date: date
):
    # 1. Get Actual scenario
    actual_scenario = db.query(Scenario).filter(Scenario.is_default == True).first()

    # 2. Fetch existing record(s) for this entity + scenario
    existing_record = db.query(ValueRecord).filter(
        ValueRecord.entity_type == entity_type,
        ValueRecord.entity_id == entity_id,
        ValueRecord.scenario_id == actual_scenario.id,
        ValueRecord.value_date == new_value_date
    ).first()

    if existing_record:
        # If there's already a record for the same date, update it
        existing_record.value_amount = new_value_amount
        db.commit()
        db.refresh(existing_record)
        return existing_record
    else:
        # Otherwise, create a new record
        new_record = ValueRecord(
            entity_type=entity_type,
            entity_id=entity_id,
            scenario_id=actual_scenario.id,
            value_date=new_value_date,
            value_amount=new_value_amount
        )
        db.add(new_record)
        db.commit()
        db.refresh(new_record)
        return new_record
```

